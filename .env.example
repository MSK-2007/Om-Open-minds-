# =============================================================================
# OM OPEN MINDS — Environment Variables Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env to version control).
# 2. Populate values with your Supabase project credentials.
# 3. Only variables prefixed with VITE_ are exposed to the client application.
# =============================================================================

# Supabase Project URL (e.g., https://yourproject.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public API Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

